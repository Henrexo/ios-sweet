diff -ruN a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
--- /dev/null
+++ b/bsd/dev/sweet_cpufreq.c
@@ -0,0 +1,118 @@
+/*
+ * SWEET/toco CPU frequency: Qualcomm OSM "cpufreq-hw" (SM7150 DT
+ * cpufreq@18323000, freq-domain0 = cpu0-5 A55, freq-domain1 = cpu6-7 A76).
+ * Register layout as Linux drivers/cpufreq/qcom-cpufreq-hw.c (v1 / OSM):
+ *   0x000 enable, 0x110 + 32*i frequency LUT, 0x114 + 32*i voltage LUT,
+ *   0x920 desired performance state (LUT index).
+ * LUT row: src = bits 31:30 (0 = GPLL0 path 300 MHz, else XO * lval),
+ * lval = bits 7:0, core count = bits 18:16. The table ends where a row
+ * repeats the previous frequency. The OSM firmware handles voltage and
+ * hardware limits; we only pick an index, like Linux does.
+ *
+ * XNU has no cpufreq driver for this SoC, so the cores stay at whatever
+ * state ABL left. This logs the table and the inherited state, then asks
+ * for the highest entry not above a cap (boot-args, MHz):
+ *   sweetcpufreq=0       leave everything as ABL left it (log only)
+ *   sweetcpumhz0=N       cap for cpu0-5 (default 1709 = one step below max)
+ *   sweetcpumhz1=N       cap for cpu6-7 (default 1940)
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void sweet_cpufreq_init(void);
+
+#define OSM_ENABLE      0x000u
+#define OSM_FREQ_LUT    0x110u
+#define OSM_VOLT_LUT    0x114u
+#define OSM_PERF_STATE  0x920u
+#define OSM_ROW         32u
+#define OSM_ROWS        40u
+#define OSM_XO_KHZ      19200u
+#define OSM_ALT_KHZ     300000u
+
+static uint32_t
+cf_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+cf_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+cf_domain(unsigned dom, vm_offset_t pa, unsigned cap_mhz, int set)
+{
+	/* 16K pages: map the aligned window that holds [pa, pa + 0x1400). */
+	vm_offset_t win = pa & ~(vm_offset_t)0x3fff;
+	vm_size_t len = ((pa - win) + 0x1400 + 0x3fff) & ~(vm_size_t)0x3fff;
+	vm_offset_t map = ml_io_map(win, len);
+	vm_offset_t base = map ? map + (pa - win) : 0;
+	if (!base) {
+		printf("SWEET CPUFREQ: domain %u map failed\n", dom);
+		return;
+	}
+	uint32_t enable = cf_rd(base, OSM_ENABLE);
+	uint32_t cur = cf_rd(base, OSM_PERF_STATE) & 0xffu;
+	printf("SWEET CPUFREQ: domain %u pa=%#lx enable=%#x perf_state=%u\n",
+	    dom, (unsigned long)pa, enable, cur);
+	if (!(enable & 1u)) {
+		printf("SWEET CPUFREQ: domain %u not enabled by firmware; leaving it alone\n", dom);
+		return;
+	}
+	unsigned n = 0, pick = 0, prev = 0;
+	unsigned khz[OSM_ROWS];
+	for (unsigned i = 0; i < OSM_ROWS; ++i) {
+		uint32_t f = cf_rd(base, OSM_FREQ_LUT + i * OSM_ROW);
+		uint32_t v = cf_rd(base, OSM_VOLT_LUT + i * OSM_ROW);
+		unsigned src = (f >> 30) & 3u, lval = f & 0xffu, cores = (f >> 16) & 7u;
+		unsigned k = src ? lval * OSM_XO_KHZ : OSM_ALT_KHZ;
+		if (i > 0 && k == prev) {
+			break;
+		}
+		printf("SWEET CPUFREQ: domain %u lut[%u] %u kHz cores=%u volt=%#x%s\n",
+		    dom, i, k, cores, v, i == cur ? " <- current" : "");
+		khz[i] = k;
+		prev = k;
+		n = i + 1;
+		if (k <= cap_mhz * 1000u) {
+			pick = i;
+		}
+	}
+	if (!n) {
+		printf("SWEET CPUFREQ: domain %u empty table\n", dom);
+		return;
+	}
+	if (cur < n) {
+		printf("SWEET CPUFREQ: domain %u inherited %u kHz\n", dom, khz[cur]);
+	}
+	if (!set || pick == cur) {
+		return;
+	}
+	cf_wr(base, OSM_PERF_STATE, pick);
+	printf("SWEET CPUFREQ: domain %u request lut[%u] = %u kHz (cap %u MHz), readback %u\n",
+	    dom, pick, khz[pick], cap_mhz, cf_rd(base, OSM_PERF_STATE) & 0xffu);
+}
+
+void
+sweet_cpufreq_init(void)
+{
+	int set = 1;
+	unsigned cap0 = 1709, cap1 = 1940;
+	(void)PE_parse_boot_argn("sweetcpufreq", &set, sizeof(set));
+	(void)PE_parse_boot_argn("sweetcpumhz0", &cap0, sizeof(cap0));
+	(void)PE_parse_boot_argn("sweetcpumhz1", &cap1, sizeof(cap1));
+	cf_domain(0, 0x18323000, cap0, set);
+	cf_domain(1, 0x18325800, cap1, set);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
