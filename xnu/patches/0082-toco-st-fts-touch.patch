+/* Read up to max events (each 8 bytes) from the FTM5 FIFO; returns count. */
+static int
+touch_stfts_read(uint8_t *buf, unsigned max, unsigned *count)
+{
+	*count = 0;
+	int err = touch_read(STFTS_ADDR, STFTS_FIFO_READ, false, buf, STFTS_EVT_SIZE);
+	if (err) {
+		return err;
+	}
+	if (buf[0] == 0) {
+		return 0; /* EVT_ID_NOEVENT */
+	}
+	unsigned more = buf[7] & 0x1fu;
+	*count = 1;
+	/* RX is limited to 90 bytes per message: drain in chunks of 11 events. */
+	while (more && *count < max) {
+		unsigned n = more;
+		if (n > 11u) {
+			n = 11u;
+		}
+		if (n > max - *count) {
+			n = max - *count;
+		}
+		err = touch_read(STFTS_ADDR, STFTS_FIFO_READ, false,
+		    buf + *count * STFTS_EVT_SIZE, n * STFTS_EVT_SIZE);
+		if (err) {
+			return err;
+		}
+		*count += n;
+		more -= n;
+	}
+	return 0;
+}
+
+static void
+touch_stfts_log(const char *what, const uint8_t *e)
+{
+	printf("SWEET TOUCH: fts %s %02x %02x %02x %02x %02x %02x %02x %02x\n", what,
+	    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+}
+
+/* Power, reset and sense-on. vdd = TLMM GPIO72 fixed regulator (live DT
+ * "touch_vddio_vreg", mainline vreg_touch_vdd: enable-active-high,
+ * startup 4 ms, vin L10A 1.8 V). Boot 5 showed it LOW after ABL (NACK at
+ * 0x49): drive it high before avdd, like fts_521 enables vdd then avdd. */
+static bool
+touch_stfts_start(void)
+{
+	uint8_t ev[STFTS_EVT_SIZE * 32];
+	unsigned n = 0;
+	touch_gpio(9, 0, 3, 3, false, false); /* IRQ input, 8 mA, pull-up (ts_active) */
+	touch_gpio(8, 0, 3, 3, true, false);  /* hold in reset while the rails settle */
+	touch_gpio(72, 0, 0, 0, true, true);  /* vdd enable, 2 mA push-pull */
+	touch_wait(10);                       /* > 4 ms startup-delay-us */
+	printf("SWEET TOUCH: vdd72 io=%#x cfg=%#x\n", touch_rd(st.gpio, TOUCH_GPIO_IO(72)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(72)));
+	int power_error = sweet_rpmh_vreg_enable("ldoc6", 3000);
+	if (power_error) {
+		printf("SWEET TOUCH: L6C RPMh enable failed %d; stopping\n", power_error);
+		return false;
+	}
+	touch_wait(10);
+	touch_gpio(6, 1, 0, 0, false, false); /* qup11 SDA/SCL, 2 mA, no bias */
+	touch_gpio(7, 1, 0, 0, false, false);
+	/* fts_system_reset with reset GPIO: low 10 ms, high, poll for READY. */
+	touch_gpio(8, 0, 3, 3, true, false);
+	touch_wait(10);
+	touch_gpio(8, 0, 3, 3, true, true);
+	bool ready = false;
+	for (unsigned t = 0; t < 100 && !ready && !st.dead; ++t) {
+		touch_wait(20);
+		st.probing = t < 3; /* log the first transfers verbosely */
+		int err = touch_stfts_read(ev, 32, &n);
+		if (err) {
+			if (t % 10u == 0) {
+				printf("SWEET TOUCH: fts poll %u err=%d irq=%#x\n", t, err, st.irq_status);
+			}
+			continue;
+		}
+		for (unsigned i = 0; i < n; ++i) {
+			touch_stfts_log("boot event", ev + i * STFTS_EVT_SIZE);
+			if (ev[i * STFTS_EVT_SIZE] == STFTS_EVT_READY) {
+				ready = true;
+			}
+		}
+	}
+	st.probing = false;
+	if (!ready) {
+		printf("SWEET TOUCH: fts no CONTROLLER_READY after reset; stopping\n");
+		return false;
+	}
+	const uint8_t sense_on[3] = {0xa0, 0x00, 0x01};
+	int err = touch_msg(STFTS_ADDR, sense_on, sizeof(sense_on), NULL, 0, false);
+	printf("SWEET TOUCH: fts sense on err=%d\n", err);
+	return err == 0;
+}
+
+static int
+touch_stfts(void)
+{
+	uint8_t ev[STFTS_EVT_SIZE * 32];
+	unsigned n = 0;
+	int err = touch_stfts_read(ev, 32, &n);
+	if (err) {
+		return err;
+	}
+	if (!n) {
+		return 0;
+	}
+	uint32_t mask = st.active;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		x[id] = st.x[id];
+		y[id] = st.y[id];
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *e = ev + i * STFTS_EVT_SIZE;
+		unsigned id = e[1] >> 4;
+		switch (e[0]) {
+		case STFTS_EVT_ENTER:
+		case STFTS_EVT_MOTION: {
+			unsigned px = ((unsigned)(e[3] & 15u) << 8) | e[2];
+			unsigned py = ((unsigned)e[4] << 4) | (e[3] >> 4);
+			if (id >= TOUCH_MAX) {
+				touch_stfts_log("bad id", e);
+				continue;
+			}
+			x[id] = (int)(px > STFTS_X_MAX ? STFTS_X_MAX : px);
+			y[id] = (int)(py > STFTS_Y_MAX ? STFTS_Y_MAX : py);
+			mask |= 1u << id;
+			break;
+		}
+		case STFTS_EVT_LEAVE:
+			if (id < TOUCH_MAX) {
+				mask &= ~(1u << id);
+			}
+			break;
+		case STFTS_EVT_READY:
+			/* FW reset itself (ESD/watchdog): sensing is off again. */
+			touch_stfts_log("unexpected ready", e);
+			mask = 0;
+			{
+				const uint8_t sense_on[3] = {0xa0, 0x00, 0x01};
+				(void)touch_msg(STFTS_ADDR, sense_on, sizeof(sense_on), NULL, 0, false);
+			}
+			break;
+		case STFTS_EVT_ERROR:
+			touch_stfts_log("error", e);
+			break;
+		default:
+			break; /* status/user/debug events */
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
